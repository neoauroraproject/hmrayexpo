# ─── Database ───────────────────────────────────────────────
# PostgreSQL connection string (used by Prisma, API, worker)
DATABASE_URL=postgresql://hmray:hmray_secret@localhost:5432/hmray?schema=public

# ─── Redis ──────────────────────────────────────────────────
# BullMQ queues, caching, sessions
REDIS_URL=redis://localhost:6379

# ─── Auth ───────────────────────────────────────────────────
# JWT signing secret (min 32 chars in production)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# ─── Seed owner account ─────────────────────────────────────
# Used by `pnpm db:seed` to create the first OWNER admin
ADMIN_USERNAME=owner
ADMIN_PASSWORD=change-me-before-seeding
ADMIN_EMAIL=admin@hmray.ir
ADMIN_DISPLAY_NAME=HMRAY Owner

# ─── Telegram Bot ───────────────────────────────────────────
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# Admin group/chat ID for notifications
ADMIN_TELEGRAM_CHAT_ID=-1001234567890
# Shared secret the bot sends as `X-Bot-Secret` on every /api/bot/* call.
# Unset means the API rejects all bot traffic.
BOT_INTERNAL_SECRET=change-me-to-a-long-random-string
# Optional: override where the bot finds the API. Defaults to `${PUBLIC_URL}/api`.
# API_BASE_URL=http://localhost:4000/api
# "polling" (default, for local dev) or "webhook" (set automatically when WEBHOOK_URL is set)
BOT_MODE=polling
# Public HTTPS URL Telegram should push updates to; leave unset to use long polling.
# WEBHOOK_URL=https://bot.hmray.ir/telegram/webhook
# Local port the bot's webhook HTTP server listens on
BOT_WEBHOOK_PORT=8088
# Optional secret compared against Telegram's X-Telegram-Bot-Api-Secret-Token header
# BOT_WEBHOOK_SECRET=change-me-too

# ─── API uploads & public links ─────────────────────────────
# Where receipts and product images are written; served at /uploads/*
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880
# Base URL of the page that renders a public quote: <base>/quote/<publicToken>
QUOTE_PUBLIC_BASE_URL=http://localhost:4000
# Comma-separated CORS allowlist; defaults to ADMIN_PUBLIC_URL + localhost:3000
# CORS_ORIGINS=http://localhost:3000

# ─── Server Ports ───────────────────────────────────────────
PORT=4000
PANEL_PORT=3000
WORKER_PORT=4001

# ─── Public URLs ────────────────────────────────────────────
# Base URL for API (used in webhooks, links)
PUBLIC_URL=http://localhost:4000
# Admin panel public URL
ADMIN_PUBLIC_URL=http://localhost:3000

# ─── Caddy / Production ─────────────────────────────────────
DOMAIN=hmray.local
PANEL_PORT=8443
ACME_EMAIL=admin@hmray.ir
TZ=Asia/Tehran

# GHCR images (production install — set by install.sh)
# HMRAY_IMAGE_PREFIX=ghcr.io/your-org/hmray
# HMRAY_IMAGE_TAG=latest
# POSTGRES_PASSWORD=change-me

# ─── Node ───────────────────────────────────────────────────
NODE_ENV=development
