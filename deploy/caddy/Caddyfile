# HMRAY — TLS reverse proxy on a custom HTTPS port
# Routes: /api/* and /health → api:4000, everything else → admin:3000
#
# Let's Encrypt HTTP-01 needs host port 80 published to this container
# (see docker-compose). Caddy binds :80 automatically for ACME even when
# the public site listens on PANEL_PORT only.

{
	email {$ACME_EMAIL}
}

{$DOMAIN}:{$PANEL_PORT} {
	encode gzip

	tls {$ACME_EMAIL}

	handle /api/* {
		reverse_proxy api:4000
	}

	handle /health {
		reverse_proxy api:4000
	}

	handle {
		reverse_proxy http://admin:3000
	}
}
